{
  "schema": 1,
  "name": "Cursed!: Reflection ignores dodged and fully absorbed hits",
  "contract": [
    "Issue #10788. Reflection reads the final damage after the hit roll and absorbs. With Major",
    "Reflection 901852 on the player, swings the target dodges (dodge 100%) and swings a Power Word:",
    "Shield 48066 absorbs completely deal no damage, so no 901856 reflection is dealt."
  ],
  "timeout_ms": 400000,
  "location": {
    "map": 0,
    "x": -9617.06,
    "y": -288.949,
    "z": 57.3053
  },
  "players": [
    {
      "id": "hero",
      "race": 1,
      "class": 1,
      "level": 1,
      "allow_regeneration": false,
      "melee_hit_rating": 10000
    },
    {
      "id": "foe",
      "race": 2,
      "class": 1,
      "level": 79,
      "allow_regeneration": false
    }
  ],
  "steps": [
    {
      "action": "start_challenge",
      "actor": "hero",
      "challenge": 617,
      "level": 1
    },
    {
      "action": "assert",
      "actor": "hero",
      "metric": "challenge_start_code",
      "equals": 0,
      "within_ms": 3000,
      "label": "the Cursed! trial activates"
    },
    {
      "action": "set_level",
      "actor": "hero",
      "value": 79
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "console",
      "command": "coa cursed presence Harnessa present"
    },
    {
      "action": "pvp",
      "actor": "hero",
      "enabled": true
    },
    {
      "action": "pvp",
      "actor": "foe",
      "enabled": true
    },
    {
      "action": "set_aura",
      "actor": "hero",
      "spell": 901852,
      "stacks": 1
    },
    {
      "action": "set_combat_avoidance",
      "actor": "foe",
      "dodge": 100,
      "parry": 0
    },
    {
      "action": "snapshot",
      "actor": "hero",
      "metric": "melee_dodges_dealt",
      "save_as": "dodges_0"
    },
    {
      "action": "snapshot",
      "actor": "hero",
      "metric": "spell_damage_count",
      "spell": 901856,
      "target": "hero",
      "save_as": "miss_0"
    },
    {
      "action": "attack_until_swings",
      "actor": "hero",
      "target": "foe",
      "swings": 3,
      "timeout_ms": 15000
    },
    {
      "action": "assert",
      "actor": "hero",
      "metric": "melee_dodges_dealt",
      "relative_to": "dodges_0",
      "min": 3,
      "label": "every swing is dodged"
    },
    {
      "action": "assert",
      "actor": "hero",
      "metric": "spell_damage_count",
      "spell": 901856,
      "target": "hero",
      "relative_to": "miss_0",
      "equals": 0,
      "label": "a dodged swing reflects nothing"
    },
    {
      "action": "set_combat_avoidance",
      "actor": "foe",
      "dodge": 0,
      "parry": 0
    },
    {
      "action": "set_aura",
      "actor": "foe",
      "spell": 48066,
      "stacks": 1,
      "caster": "foe"
    },
    {
      "action": "snapshot",
      "actor": "hero",
      "metric": "melee_damage_count",
      "save_as": "hits_0"
    },
    {
      "action": "snapshot",
      "actor": "hero",
      "metric": "melee_attack_count",
      "save_as": "swings_0"
    },
    {
      "action": "snapshot",
      "actor": "hero",
      "metric": "spell_damage_count",
      "spell": 901856,
      "target": "hero",
      "save_as": "absorb_0"
    },
    {
      "action": "attack_until_swings",
      "actor": "hero",
      "target": "foe",
      "swings": 2,
      "timeout_ms": 15000
    },
    {
      "action": "assert",
      "actor": "hero",
      "metric": "melee_attack_count",
      "relative_to": "swings_0",
      "min": 2,
      "label": "the swings happen"
    },
    {
      "action": "assert",
      "actor": "hero",
      "metric": "melee_damage_count",
      "relative_to": "hits_0",
      "equals": 0,
      "label": "the shield absorbs every swing"
    },
    {
      "action": "assert",
      "actor": "hero",
      "metric": "spell_damage_count",
      "spell": 901856,
      "target": "hero",
      "relative_to": "absorb_0",
      "equals": 0,
      "label": "a fully absorbed hit reflects nothing"
    }
  ]
}
