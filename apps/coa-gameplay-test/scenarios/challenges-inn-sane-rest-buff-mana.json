{
  "schema": 1,
  "name": "Inn-Sane: the Rest buff restores no mana outside a rest area (#11278)",
  "contract": [
    "Issue #11278. Drinking applies the Rest buff (818011), whose OBS_MOD_POWER effect restores 2% of maximum mana",
    "every 2 seconds. Inn-Sane (challenge 76) declares NO_MANA_REGENERATION_UNLESS_RESTED and",
    "NO_ENERGIZING_UNLESS_RESTED, so outside a rest area that tick must restore nothing; inside an inn it restores",
    "mana as usual. Both actors drink Refreshing Spring Water (159, Drink 430) with natural regeneration disabled, so",
    "the drink's own MOD_POWER_REGEN cannot add mana and any gain comes from the Rest tick. The control, outside any",
    "challenge, gains mana outdoors. The trial starts Inn-Sane at level 1 as required, is raised to level 10 for a",
    "measurable 2%, and gains nothing outdoors, then gains mana after entering Goldshire inn through its real area",
    "trigger 562."
  ],
  "timeout_ms": 120000,
  "location": {"map": 0, "x": -9617.06, "y": -288.949, "z": 57.3053},
  "players": [
    {"id": "trial", "race": 1, "class": 25, "level": 1, "allow_regeneration": false},
    {"id": "control", "race": 1, "class": 25, "level": 10, "allow_regeneration": false}
  ],
  "steps": [
    {"action": "start_challenge", "actor": "trial", "challenge": 76, "level": 1},
    { "action": "assert", "label": "Inn-Sane activates", "actor": "trial", "metric": "challenge_start_code",
      "equals": 0, "within_ms": 3000 },
    { "action": "assert", "label": "the Inn-Sane challenge aura is active", "actor": "trial", "metric": "aura",
      "spell": 93149, "equals": 1 },
    {"action": "set_level", "actor": "trial", "value": 10},
    { "action": "assert", "label": "CONTROL: both actors start outdoors", "actor": "trial", "metric": "resting",
      "equals": 0 },
    { "action": "assert", "label": "CONTROL: both actors start outdoors", "actor": "control", "metric": "resting",
      "equals": 0 },
    {"action": "add_item", "actor": "trial", "item": 159, "count": 2},
    {"action": "add_item", "actor": "control", "item": 159, "count": 1},
    {"action": "set_power", "actor": "trial", "power": 0, "value": 10},
    {"action": "set_power", "actor": "control", "power": 0, "value": 10},
    {"action": "use_item", "label": "the trial drinks outdoors", "actor": "trial", "item": 159, "spell": 430},
    {"action": "use_item", "label": "the control drinks outdoors", "actor": "control", "item": 159, "spell": 430},
    { "action": "assert", "label": "Rest applies to the drinking trial", "actor": "trial", "metric": "aura",
      "spell": 818011, "equals": 1, "within_ms": 3000 },
    { "action": "assert", "label": "Rest applies to the drinking control", "actor": "control", "metric": "aura",
      "spell": 818011, "equals": 1, "within_ms": 3000 },
    {"action": "wait", "ms": 6500},
    { "action": "assert", "label": "CONTROL: Rest restores mana outside a challenge", "actor": "control",
      "metric": "power", "power": 0, "min": 11 },
    { "action": "assert", "label": "Rest restores no mana to the Inn-Sane trial outdoors", "actor": "trial",
      "metric": "power", "power": 0, "equals": 10 },
    {"action": "teleport", "actor": "trial", "map": 0, "x": -9483.25, "y": -17.9883, "z": 56.9634},
    {"action": "area_trigger", "actor": "trial", "id": 562},
    { "action": "assert", "label": "the Goldshire inn trigger grants rest", "actor": "trial", "metric": "resting",
      "equals": 1, "within_ms": 3000 },
    { "action": "assert", "label": "the first drink has ended", "actor": "trial", "metric": "aura", "spell": 430,
      "equals": 0, "within_ms": 30000 },
    {"action": "set_power", "actor": "trial", "power": 0, "value": 10},
    {"action": "use_item", "label": "the trial drinks in the inn", "actor": "trial", "item": 159, "spell": 430},
    { "action": "assert", "label": "Rest applies in the inn", "actor": "trial", "metric": "aura", "spell": 818011,
      "equals": 1, "within_ms": 3000 },
    {"action": "wait", "ms": 6500},
    { "action": "assert", "label": "Rest restores mana to the Inn-Sane trial in the inn", "actor": "trial",
      "metric": "power", "power": 0, "min": 11 }
