    {
      "action": "assert",
      "actor": "hero",
      "metric": "spell_damage_count",
      "spell": 901856,
      "target": "hero",
      "relative_to": "shield_0",
      "equals": 0,
      "within_ms": 2000,
      "label": "the player's own shield absorbs the reflected damage"
    },
    {
      "action": "set_aura",
      "actor": "hero",
      "spell": 48066,
      "stacks": 0
