    },
    {
      "action": "pvp",
      "actor": "hero",
      "enabled": true
    },
    {
      "action": "pvp",
      "actor": "foe",
      "enabled": true
    },
    {
      "action": "set_combat_avoidance",
      "actor": "foe",
      "dodge": 0,
      "parry": 0
    },
    {
      "action": "set_aura",
      "actor": "hero",
      "spell": 901852,
      "stacks": 1
    },
    {
