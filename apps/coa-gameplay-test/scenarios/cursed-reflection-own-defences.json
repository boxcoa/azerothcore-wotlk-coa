{
  "schema": 1,
  "name": "Cursed!: the player's own shield and immunity stop reflected damage",
  "contract": [
    "Issue #10788. Reflection's 901856 damage goes through the player's own immunity and absorbs, as",
    "a normal spell hit does. With Major Reflection 901852 on the player, a Power Word: Shield 48066 on",
    "the player absorbs the reflected damage and Divine Shield 642 makes the player immune to it."
  ],
  "timeout_ms": 400000,
  "location": {
    "map": 0,
    "x": -9617.06,
    "y": -288.949,
    "z": 57.3053
  },
  "players": [
    {
      "id": "hero",
      "race": 1,
      "class": 1,
      "level": 1,
      "allow_regeneration": false,
      "melee_hit_rating": 10000,
      "expertise_rating": 10000
    },
    {
      "id": "foe",
      "race": 2,
      "class": 1,
      "level": 79,
      "allow_regeneration": false
    }
  ],
  "steps": [
    {
      "action": "start_challenge",
      "actor": "hero",
      "challenge": 617,
      "level": 1
    },
    {
      "action": "assert",
      "actor": "hero",
      "metric": "challenge_start_code",
      "equals": 0,
      "within_ms": 3000,
      "label": "the Cursed! trial activates"
    },
    {
      "action": "set_level",
      "actor": "hero",
      "value": 79
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "console",
