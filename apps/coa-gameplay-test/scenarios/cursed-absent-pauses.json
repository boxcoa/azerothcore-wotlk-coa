{
  "schema": 1,
  "name": "Cursed!: an absent client pauses the warning and gets the curse announced again",
  "contract": [
    "Issue #10788. While the client is absent the warning stops. Narcolepsy 901841 is announced, the",
    "player is marked absent for 30 s and nothing lands; once present again the curse is announced",
    "again with at least a 10 s warning and lands after the proof reply."
  ],
  "timeout_ms": 300000,
  "location": {
    "map": 0,
    "x": -9617.06,
    "y": -288.949,
    "z": 57.3053
  },
  "players": [
    {
      "id": "hero",
      "race": 1,
      "class": 1,
      "level": 1
    }
  ],
  "steps": [
    {
      "action": "start_challenge",
      "actor": "hero",
      "challenge": 617,
      "level": 1
    },
    {
      "action": "assert",
      "actor": "hero",
      "metric": "challenge_start_code",
      "equals": 0,
      "within_ms": 3000,
      "label": "the Cursed! trial activates"
    },
    {
      "action": "assert",
      "actor": "hero",
      "metric": "aura",
      "spell": 943601,
      "equals": 1,
      "within_ms": 3000,
      "label": "the trial applies Cursed! 943601"
    },
    {
      "action": "set_level",
      "actor": "hero",
      "value": 10
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "console",
      "command": "coa cursed presence Harnessa present"
    },
    {
      "action": "console",
      "command": "coa cursed force Harnessa 901841"
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "console",
      "command": "coa cursed presence Harnessa absent"
    },
    {
      "action": "wait",
      "ms": 30000
    },
    {
      "action": "assert",
      "actor": "hero",
      "metric": "aura",
      "spell": 901841,
      "equals": 0,
      "label": "nothing lands while the client is absent"
    },
    {
      "action": "snapshot",
      "actor": "hero",
      "metric": "system_messages",
      "save_as": "back"
    },
    {
      "action": "console",
      "command": "coa cursed presence Harnessa present"
    },
    {
      "action": "assert",
      "actor": "hero",
      "metric": "system_messages",
      "relative_to": "back",
      "label": "the curse is announced again",
      "min": 1,
      "within_ms": 2000
    },
    {
      "action": "wait",
      "ms": 8000
    },
    {
      "action": "console",
      "command": "coa cursed reply Harnessa major"
    },
    {
      "action": "assert",
      "actor": "hero",
      "metric": "aura",
      "spell": 901841,
      "equals": 1,
      "label": "the curse lands after the recovery window",
      "within_ms": 6000
    }
  ]
}
