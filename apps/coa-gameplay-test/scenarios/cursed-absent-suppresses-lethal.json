{
  "schema": 1,
  "name": "Cursed!: curse damage is suppressed while the client is absent",
  "contract": [
    "Issue #10788. Once absence is detected, damage from trial-cast curse spells is reduced to 0 and",
    "the aura keeps running. Starvation 901871 ticks 10% every 2 s; while the player is marked absent",
    "for 6 s health does not change, and the ticks hurt again once the player is present."
  ],
  "timeout_ms": 400000,
  "location": {
    "map": 0,
    "x": -9617.06,
    "y": -288.949,
    "z": 57.3053
  },
  "players": [
    {
      "id": "hero",
      "race": 1,
      "class": 1,
      "level": 1,
      "allow_regeneration": false
    }
  ],
  "steps": [
    {
      "action": "start_challenge",
      "actor": "hero",
      "challenge": 617,
      "level": 1
    },
    {
      "action": "assert",
      "actor": "hero",
      "metric": "challenge_start_code",
      "equals": 0,
      "within_ms": 3000,
      "label": "the Cursed! trial activates"
    },
    {
      "action": "set_level",
      "actor": "hero",
      "value": 20
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "console",
      "command": "coa cursed presence Harnessa present"
    },
    {
      "action": "console",
      "command": "coa cursed force Harnessa 901871"
    },
    {
      "action": "wait",
      "ms": 16000
    },
    {
      "action": "console",
      "command": "coa cursed reply Harnessa major"
    },
    {
      "action": "assert",
      "actor": "hero",
      "metric": "aura",
      "spell": 901871,
      "equals": 1,
      "within_ms": 6000,
      "label": "Starvation lands 5 s after its reminder"
    },
    {
      "action": "wait",
      "ms": 2500
    },
    {
      "action": "console",
      "command": "coa cursed presence Harnessa absent"
    },
    {
      "action": "wait",
      "ms": 200
    },
    {
      "action": "snapshot",
      "actor": "hero",
      "metric": "health",
      "save_as": "absent_0"
    },
    {
      "action": "wait",
      "ms": 6000
    },
    {
      "action": "assert",
      "actor": "hero",
      "metric": "health",
      "relative_to": "absent_0",
      "equals": 0,
      "label": "no curse damage while the client is absent"
    },
    {
      "action": "console",
      "command": "coa cursed presence Harnessa present"
    },
    {
      "action": "wait",
      "ms": 4500
    },
    {
      "action": "assert",
      "actor": "hero",
      "metric": "health",
      "relative_to": "absent_0",
      "max": -1,
      "label": "curse damage resumes once the client is present"
    }
  ]
