{
  "schema": 1,
  "name": "Cursed!: the first curse waits for the gap, is announced, then lands after its warning",
  "contract": [
    "Issue #10788. Each Cursed! lane waits a random 30-60 s gap before its first roll, so no curse",
    "is announced in the first 28 s. A forced tier 1 curse (Shortening 901844) is announced at once, asks",
    "for a time-sync proof with the announcement and lands 5 s later once the proof reply arrives."
  ],
  "timeout_ms": 300000,
  "location": {
    "map": 0,
    "x": -9617.06,
    "y": -288.949,
    "z": 57.3053
  },
  "players": [
    {
      "id": "hero",
      "race": 1,
      "class": 1,
      "level": 1
    }
  ],
  "steps": [
