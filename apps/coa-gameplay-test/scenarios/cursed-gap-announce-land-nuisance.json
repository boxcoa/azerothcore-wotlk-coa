      "action": "start_challenge",
      "actor": "hero",
      "challenge": 617,
      "level": 1
    },
    {
      "action": "assert",
      "actor": "hero",
      "metric": "challenge_start_code",
      "equals": 0,
      "within_ms": 3000,
      "label": "the Cursed! trial activates"
    },
    {
      "action": "assert",
      "actor": "hero",
      "metric": "aura",
      "spell": 943601,
      "equals": 1,
      "within_ms": 3000,
